{
  "manifest_version": 3,
  "name": "unAI Text - AI Detector & Humanizer",
  "short_name": "unAI Text",
  "version": "1.0.0",
  "description": "300ms AI detector, one-click AI cliché cleaner (delve, furthermore), and text humanizer with LaTeX formula & table protection.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "unAI Text - AI Detector & Humanizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ]
}
